{
  "name": "party-night",
  "productName": "Party Night",
  "version": "1.2.0",
  "description": "Party games on your TV, played from your phones",
  "main": "app.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.partynight.app",
    "files": [
      "app.js",
      "preload.js",
      "server.js",
      "games/**",
      "public/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Party Night",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Party Night"
    },
    "publish": {
      "provider": "github",
      "owner": "veneito",
      "repo": "party-night",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4"
  },
  "repository": "github:veneito/party-night",
  "license": "MIT",
  "author": "Randall J. Russell Hernadez"
}
